{
	"name": "@carragom/deno-pg-ffi",
	"version": "0.1.0-alpha.4",
	"github": "https://github.com/carragom/deno-pg-ffi",
	"description": "Deno native bindings for PostgreSQL libpq",
	"lock": false,
	"exports": {
		".": "./src/mod.ts",
		"./libpq": "./src/libpq.ts"
	},
	"publish": {
		"include": [
			"deno.json",
			"LICENSE",
			"THIRD_PARTY_LICENSES.txt",
			"src/**/*.ts",
			"prebuilds/*.so",
			"prebuilds/*.dylib"
		],
		"exclude": ["src/**/*_test.ts", "!prebuilds/"]
	},
	"fmt": {
		"useTabs": true,
		"indentWidth": 3,
		"singleQuote": true,
		"semiColons": false
	},
	"lint": {
		"rules": {
			"tags": ["recommended", "jsr"],
			"include": [
				"camelcase",
				"no-sync-fn-in-async-fn",
				"single-var-declarator",
				"no-console"
			]
		}
	},
	"test": {
		"permissions": {
			"all": true
		}
	},
	"bench": {
		"permissions": {
			"all": true
		}
	},
	"tasks": {
		"check:docs": "deno doc --lint src/mod.ts src/libpq.ts",
		"build:libpq": "deno -A scripts/build-libpq.ts",
		"test": "deno test -P --trace-leaks --doc --clean",
		"test:local": {
			"command": "deno test -P --preload=./scripts/select-local-libpq.ts --trace-leaks --doc --clean",
			"dependencies": [
				"build:libpq"
			]
		},
		"bench": "deno bench -P bench/client.ts",
		"bench:compare": "deno bench -P bench/compare.ts",
		"bench:local": {
			"command": "deno bench -P --preload=./scripts/select-local-libpq.ts bench/client.ts",
			"dependencies": [
				"build:libpq"
			]
		}
	},
	"exclude": [
		".git",
		".github",
		"coverage",
		"postgres"
	],
	"imports": {
		"@denosaurs/plug": "jsr:@denosaurs/plug@^1.1.0",
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@std/async": "jsr:@std/async@^1.5.0",
		"@std/cli": "jsr:@std/cli@^1.0.32",
		"@std/fs": "jsr:@std/fs@^1.0.24",
		"@std/path": "jsr:@std/path@^1.1.6"
	}
}
